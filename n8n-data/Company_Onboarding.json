    {
      "parameters": {
        "operation": "update",
        "schema": "web",
        "table": "Company",
        "updateKey": "id",
        "columns": "brandVoice",
        "options": {}
      },
      "name": "Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [850, 300],
      "notes": "Save Brand Voice to DB"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
