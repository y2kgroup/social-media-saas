          "messageValues": [
            {
              "content": "Analyze the following website content and extract the brand voice, key products, and target audience. Format as a concise summary.\n\n{{$json.data}}"
            }
          ]
        }
      },
      "name": "OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 300],
