        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "notes": "Receives Company URL from Next.js Dashboard"
    },
    {
      "parameters": {
        "url": "={{$json.body.website}}",
        "options": {}
      },
      "name": "HTTP Request",
