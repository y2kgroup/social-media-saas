r step in that direction.\\n\\nFor more details and to take advantage of this opportunity, please visit the link in our bio.\\n\\n#{{$json.name}} #{{$json.title}} #Business #Announcement\",\"generationInfo\":{\"finishReason\":\"STOP\",\"index\":0}}]]},\"tokenUsage\":{\"completionTokens\":352,\"promptTokens\":41,\"totalTokens\":393}}}"}}
